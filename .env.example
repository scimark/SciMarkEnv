# Скопировать в .env и заполнить. .env в git не попадает.

# --- Postgres ---
POSTGRES_DB=honest-sign
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# --- pgAdmin ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=

# --- Jira / Confluence (mcp-atlassian) ---
JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_PERSONAL_TOKEN=
# ATLASSIAN_READ_ONLY=true
# ATLASSIAN_TOOLSETS=all
# ATLASSIAN_SSL_VERIFY=false

# --- Jenkins (mcp-jenkins) ---
JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=
JENKINS_PASSWORD=
# JENKINS_TIMEOUT=30

# --- LLM (mcp-llm) ---
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_THINKING=true
# LLM_REASONING_EFFORT=xhigh   # low | medium | xhigh
# LLM_TIMEOUT=900              # сек, xhigh думает долго
# Папка, видимая серверу на чтение (путь со стороны docker-демона, у нас WSL)
WORKSPACE_DIR=/mnt/c/Scimark
